---
import { Image } from 'astro:assets';
import OgpCard from './OgpCard.astro';
import { fetchOgp } from '../../lib/fetchOgp';

export interface Props {
  title: string;
  event: string;
  /** 開催日（YYYY / YYYY-MM / YYYY-MM-DD）。表示は年のみ */
  date: string;
  url: string | null;
  id: string;
  description?: string | null;
  /** サムネイル画像。src/assets/speaking/ 配下のファイル名でマッチング */
  image?: string | null;
}

const { title, event, date, url, id, description, image } = Astro.props;

// src/assets/speaking/ の画像を一括読み込み
const speakingImages = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/speaking/*.{jpg,JPG,jpeg,png,webp}',
  { eager: true },
);

/** image（例: "/images/speaking/foo.jpg"）からファイル名を抽出してマッチング */
function resolveImage(src: string): ImageMetadata | undefined {
  const filename = src.split('/').pop()!;
  const entry = Object.entries(speakingImages).find(([path]) =>
    path.endsWith(`/${filename}`),
  );
  return entry?.[1].default;
}

const thumbnail = image ? resolveImage(image) : undefined;

/** date は YYYY[-MM[-DD]] 形式。表示は年のみ */
const year = date.slice(0, 4);

const isYouTube = url
  ? url.includes('youtube.com') || url.includes('youtu.be')
  : false;

const ogp = isYouTube ? await fetchOgp(url!) : null;

/** 文字列から決定論的な hue（0〜359）を生成 */
function stringToHue(str: string): number {
  let hash = 0;
  for (const char of str) {
    hash = (hash << 5) - hash + char.charCodeAt(0);
    hash |= 0;
  }
  return Math.abs(hash) % 360;
}

const hue = stringToHue(id);
const gradient = `linear-gradient(135deg, oklch(0.35 0.13 ${hue}) 0%, oklch(0.55 0.11 ${hue + 3}) 35%, oklch(0.78 0.08 ${hue + 5}) 50%, oklch(0.50 0.12 ${hue + 2}) 65%, oklch(0.32 0.11 ${hue}) 100%)`;
---

{isYouTube && ogp ? (
  <OgpCard
    externalUrl={url!}
    title={ogp.title}
    description={ogp.description}
    ogpImage={ogp.ogpImage}
  />
) : (
  <a
    href={url ?? undefined}
    target={url ? '_blank' : undefined}
    rel={url ? 'noopener noreferrer' : undefined}
    class:list={[
      'group flex flex-col rounded-2xl overflow-hidden border no-underline',
      url ? 'transition-shadow hover:shadow-lg cursor-pointer' : 'cursor-default',
    ]}
    class:list={['bg-surface border-border shadow-[0_1px_4px_var(--color-shadow-sm)]']}
  >
    <!-- サムネイル（画像があれば表示、なければグラデーションプレースホルダー） -->
    <div
      class="aspect-[1200/630] w-full overflow-hidden"
      style={`background: ${gradient};`}
    >
      {thumbnail && (
        <Image
          src={thumbnail}
          alt={`${event} — ${title}`}
          width={1200}
          class="w-full h-full object-contain"
          loading="lazy"
          decoding="async"
        />
      )}
    </div>

    <!-- テキスト -->
    <div class="flex flex-col gap-1 p-3 flex-1">
      <span class="text-sm font-mono text-text-muted">{year} — {event}</span>
      <p class="text-base font-semibold leading-tight line-clamp-2 text-base-100">
        {title}
      </p>
      {description && (
        <p class="text-sm leading-relaxed line-clamp-3 mt-1 text-text-muted">
          {description}
        </p>
      )}
    </div>
  </a>
)}
