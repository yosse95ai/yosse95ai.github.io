---
import SkillItem from '../molecules/SkillItem.astro';
import { getCollection } from 'astro:content';

// getCollection() の返却順は保証されないため order 昇順で明示的に並べる
const allSkills = (await getCollection('skills')).sort(
  (a, b) => a.data.order - b.data.order,
);

const categories = [
  { key: 'cloud',     label: 'Cloud' },
  { key: 'language',  label: 'Language' },
  { key: 'framework', label: 'Framework' },
  { key: 'tool',      label: 'Tool' },
  { key: 'other',     label: 'Certification' },
] as const;

const skillsByCategory = Object.fromEntries(
  categories.map(({ key }) => [
    key,
    allSkills.filter(s => s.data.category === key),
  ])
);
---

<section
  class="rounded-3xl p-6 flex flex-col gap-5 w-full bg-surface shadow-[0_1px_4px_var(--color-shadow-sm)]"
>
  <h2 class="text-sm md:text-base font-semibold uppercase tracking-wider text-primary">
    Skills
  </h2>

  <div class="flex flex-col gap-4">
    {categories.map(({ key, label }) => (
      <div>
        <p class="text-sm md:text-base font-mono mb-2 text-text-secondary">{label}</p>
        <div class="flex flex-wrap gap-1">
          {skillsByCategory[key].map(skill => (
            <SkillItem
              name={skill.data.name}
              icon={skill.data.icon}
              url={skill.data.url}
              category={skill.data.category}
            />
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
